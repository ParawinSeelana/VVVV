--------------------------- [[ Loops: Match ]] ---------------------------

local placePending, macroPending = false, false
local markers = {} -- slot -> placement point ball

if not IS_LOBBY then
	local gameData = workspace._DATA
	local soldThisMatch, leaving = false, false
	-- Replay restarts the match in this same server (game_restarted): every loop resets its per-match state on it
	local matchNo = 1
	Track(fromServer.game_restarted.OnClientEvent:Connect(function()
		matchNo += 1
		soldThisMatch, leaving = false, false
	end))

	-- wave skip vote: the event's arguments are packed, but only its arrival matters
	Track(fromServer.start_vote_wave_skip.OnClientEvent:Connect(function()
		if State.AutoSkip then task.spawn(Invoke, "vote_wave_skip") end
	end))

	Track(workspace._wave_num.Changed:Connect(function(wave)
		MatchStatus("Wave " .. tostring(wave) .. "  |  Money " .. tostring(Money()))
		if State.AutoSell and not soldThisMatch and wave >= State.SellWave then
			soldThisMatch = true
			for _, m in MyUnits() do Invoke("sell_unit_ingame", InstanceId(m)) end
			Notify("Sold all units at wave " .. wave)
		end
		if State.LobbyAtWave and not leaving and wave >= State.LobbyWave then
			leaving = true
			task.spawn(function()
				if TeleportDelay("Back to the lobby at wave " .. wave, function() return State.LobbyAtWave end) then
					Invoke("teleport_back_to_lobby")
				else
					leaving = false
				end
			end)
		end
	end))

	-- match end: Replay / Next Stage / Lobby, the votes the results screen sends
	local function NextVote(victory)
		local d = Loader.LevelData
		local w = Data.Worlds[d.world]
		if victory and w and w.legend_stage then return "next_legend" end
		if victory and d._is_actual_storymode then return "next_story" end
		if victory and d._gamemode == "raid" then return "next_raid" end
		return "replay"
	end
	local Compress = Loader.load_core_class(script, "Compress")
	Track(fromServer.game_finished.OnClientEvent:Connect(function(...)
		local ok, results = pcall(Compress.DecodePacket, ...)
		local victory = ok and type(results) == "table" and results.victory == true
		-- a recording ends with its match, so a replay doesn't record over it
		if State.RecordMacro then
			Elevate()
			if recordTarget then Notify("Saved " .. recordTarget .. " - " .. Summary(recording)) end
			State.RecordMacro, recording, recordTarget = false, nil, nil
			pcall(recordToggle.Set, recordToggle, { CurrentValue = false })
		end
		task.delay(3, function()
			local action = State.EndAction
			if closed or action == "Nothing" then return end
			if not TeleportDelay(action, function() return State.EndAction == action end) then return end
			if action == "Replay" then
				Invoke("set_game_finished_vote", Loader.LevelData._gamemode == "infinite_tower" and "next_infinite_tower" or "replay")
			elseif action == "Next Stage" then
				Invoke("set_game_finished_vote", NextVote(victory))
			elseif action == "Lobby" then
				Invoke("teleport_back_to_lobby")
			end
		end)
	end))

	-- start vote after a countdown, leaving time to place or cancel
	task.spawn(function()
		local countdown, lastVote, seen = nil, 0, matchNo
		while not closed do
			if seen ~= matchNo then seen, countdown, lastVote = matchNo, nil, 0 end
			if gameData.GameStarted.Value or not State.AutoStart then
				countdown = nil
			else
				countdown = countdown or State.StartDelay
				if countdown > 0 then
					MatchStatus("Auto start in " .. countdown .. "s")
					countdown -= 1
				elseif os.clock() - lastVote > 10 then
					lastVote = os.clock()
					MatchStatus("Voted to start")
					Invoke("vote_start")
				end
			end
			task.wait(1)
		end
	end)

	-- Auto Place: one placement a second, the slot with the fewest copies down first
	task.spawn(function()
		local bad, refusals, full = {}, {}, {} -- refused spots, refusals in a row per unit, units at their limit
		local hologramKey, lastSpots -- what the holograms were laid out for; every slot's point last tick
		local seen = matchNo
		while not closed do
			task.wait(1)
			Elevate()
			if seen ~= matchNo then seen, bad, refusals, full, hologramKey = matchNo, {}, {}, {}, nil end
			local ok, problem = pcall(function()
				local placed = {}
				for _, m in MyUnits() do
					local id = m._stats.uuid.Value
					placed[id] = (placed[id] or 0) + 1
				end
				local pickSlot, lines, slots = nil, {}, {}
				for _, slotN in SLOTS do
					local slot = tostring(slotN)
					local cfg = State.Slots[slot]
					local uuid = SlotUuid(slot)
					local u = Owned(uuid)
					local data = u and Data.Units[u.unit_id]
					local anchor, where
					if data and cfg.On then anchor, where = PlaceAnchor(slot, u.unit_id) end

					if anchor and State.ShowPlacePoint then
						if not markers[slot] then
							markers[slot] = Instance.new("Part")
							markers[slot].Shape, markers[slot].Size, markers[slot].Anchored = Enum.PartType.Ball, Vector3.new(2, 2, 2), true
							markers[slot].CanCollide, markers[slot].CanQuery, markers[slot].CanTouch = false, false, false
							markers[slot].Material, markers[slot].Color, markers[slot].Transparency = Enum.Material.Neon, Color3.fromHSV((slotN - 1) / 6, 0.8, 1), 0.3
							markers[slot].Name, markers[slot].Parent = "VaderPlacePoint" .. slot, workspace
						end
						markers[slot].Position = anchor + Vector3.new(0, 1, 0)
					elseif markers[slot] then
						markers[slot]:Destroy()
						markers[slot] = nil
					end

					if data and cfg.On then
						local count, cap = placed[uuid] or 0, math.min(cfg.Max, data.spawn_cap or cfg.Max)
						local farm = IsFarm(u.unit_id)
						table.insert(lines, string.format("%s %s: %d/%d%s", slot, UnitName(u.unit_id), count, cap, anchor and (" at " .. where) or (" - " .. where)))
						if anchor then
							table.insert(slots, { slot = slot, uuid = uuid, u = u, data = data, count = count, cap = cap, anchor = anchor, farm = farm })
						end
						local before = not pickSlot or (State.FarmsFirst and farm and not pickSlot.farm)
							or ((not State.FarmsFirst or farm == pickSlot.farm) and count < pickSlot.count)
						if anchor and not full[uuid] and count < cap and before then
							pickSlot = { slot = slot, uuid = uuid, u = u, data = data, count = count, anchor = anchor, farm = farm }
						end
					end
				end

				placePending = State.AutoPlace and not State.PlayMacro and pickSlot ~= nil
				local note
				if not State.AutoPlace then
					note = "Auto Place is off."
				elseif State.PlayMacro then
					note = "Paused while Play Macro is on."
				elseif not pickSlot then
					note = "Every slot that's on is placed."
				else
					local name = "slot " .. pickSlot.slot .. " " .. UnitName(pickSlot.u.unit_id)
					local cost = SpawnCost(pickSlot.u.unit_id)
					local okc, cooling = pcall(function() return session.collection:is_unit_on_cooldown(pickSlot.uuid) end)
					if Money() < cost then
						note = string.format("Next: %s - waiting for %d¥", name, cost)
					elseif okc and cooling then
						note = "Next: " .. name .. " - on cooldown"
					else
						local _, origin, key = FindSpot(pickSlot.data, pickSlot.anchor, bad)
						if not origin then
							full[pickSlot.uuid] = true
							note = "No free spot for " .. name .. " within 30 studs of its point - skipping it."
						elseif Spawn(pickSlot.uuid, origin) then
							refusals[pickSlot.uuid] = 0
							note = string.format("Placed %s #%d", name, pickSlot.count + 1)
						else
							bad[key] = true
							refusals[pickSlot.uuid] = (refusals[pickSlot.uuid] or 0) + 1
							if refusals[pickSlot.uuid] >= 5 then full[pickSlot.uuid] = true end -- the server's limit
							note = string.format("%s was refused at a spot (%d/5)", name, refusals[pickSlot.uuid])
						end
					end
				end
				PlaceStatus(note .. (#lines > 0 and ("\n" .. table.concat(lines, "\n")) or ""))

				-- holograms: rebuilt when what's placed, refused or planned changes; while a point moves (a distance
				-- slider being dragged) they clear and wait for it to settle
				if State.ShowHolograms then
					local key, spots, refused = { #CS:GetTagged("player_units"), State.FarmsFirst and "F" or "" }, {}, 0
					for _ in bad do refused += 1 end
					for _, s in slots do
						table.insert(key, string.format("%s:%d/%d%s", s.slot, s.count, s.cap, full[s.uuid] and "F" or ""))
						table.insert(spots, string.format("%.0f,%.0f", s.anchor.X, s.anchor.Z))
					end
					key = table.concat(key, "|") .. "#" .. refused
					spots = table.concat(spots, "|")
					if spots ~= lastSpots then
						lastSpots = spots
						if hologramKey then
							hologramKey = nil
							ClearHolograms()
						end
					elseif key ~= hologramKey then
						hologramKey = key
						BuildHolograms(slots, bad, full)
					end
				elseif hologramKey then
					hologramKey = nil
					ClearHolograms()
				end
			end)
			if not ok then PlaceStatus("Auto Place error: " .. tostring(problem)) end
		end
	end)

	-- Play Macro
	task.spawn(function()
		local loaded, steps, finished = false, {}, false
		local models, taken, bad = {}, {}, {}
		local i, tries = 1, 0
		local function advance() i, tries = i + 1, 0 end
		local function retry(why)
			tries += 1
			if tries >= 5 then
				MacroStatus(string.format("Step %d/%d skipped: %s", i, #steps, why))
				advance()
			end
		end
		-- your copy of a recorded unit: an equipped one with that unit id, the least placed first
		local function MacroUnit(unitId)
			local placed = {}
			for _, m in MyUnits() do placed[m._stats.uuid.Value] = (placed[m._stats.uuid.Value] or 0) + 1 end
			local best
			for _, slot in SLOTS do
				local uuid = SlotUuid(slot)
				local u = Owned(uuid)
				if u and u.unit_id == unitId and (not best or (placed[uuid] or 0) < (placed[best.uuid] or 0)) then best = { uuid = uuid, slot = tostring(slot) } end
			end
			return best
		end
		local seen = matchNo
		while not closed do
			task.wait(0.5)
			Elevate()
			if seen ~= matchNo then
				seen, loaded, steps, finished = matchNo, false, {}, false
				models, taken, bad, i, tries = {}, {}, {}, 1, 0
			end
			-- the macro can still change until its first step runs
			if i == 1 and ActiveMacroName() ~= loaded then
				loaded = ActiveMacroName()
				steps = LoadMacro(loaded)
				MacroStatus(string.format("%s / %s -> %s", tostring(CurrentMode()), tostring(MapKey()), loaded and (loaded .. " (" .. Summary(steps) .. ")") or "no macro"))
			end
			macroPending = State.PlayMacro and not State.RecordMacro and i <= #steps
			if i > #steps then
				if #steps > 0 and not finished then
					finished = true
					MacroStatus(tostring(loaded) .. " finished (" .. #steps .. " steps)")
				end
			elseif State.PlayMacro and not State.RecordMacro then
				local step = steps[i]
				local m = step.unit and models[step.unit]
				local spawnStep = step.type == "spawn" and step or steps[step.unit or 0]
				local name = UnitName((m and m.Parent and m._stats.id.Value) or (spawnStep and spawnStep.unit_id))
				local function status(note) MacroStatus(string.format("Step %d/%d: %s %s - %s", i, #steps, step.type, name, note)) end
				if step.type == "spawn" then
					local mine = MacroUnit(step.unit_id)
					local cost = SpawnCost(step.unit_id)
					if not mine then
						MacroStatus(string.format("Step %d/%d skipped: %s isn't on your team", i, #steps, name))
						advance()
					elseif Money() < cost then
						status("waiting for " .. cost .. "¥")
					else
						local before, spot, origin, key = Snapshot(), nil, nil, nil
						if State.MacroSlotSpots then
							local anchor = PlaceAnchor(mine.slot, step.unit_id)
							if anchor then spot, origin, key = FindSpot(Data.Units[step.unit_id], anchor, bad) end
						end
						local okSpawn
						if origin then
							okSpawn = Spawn(mine.uuid, origin)
						else
							okSpawn = Invoke("spawn_unit", mine.uuid, { Origin = V(step.origin), Direction = V(step.dir) }, step.rot or 0)
						end
						if okSpawn then
							models[i] = NewUnit(mine.uuid, before, 3)
							if models[i] then taken[models[i]] = true end
							advance()
						else
							if key then bad[key] = true end
							retry("server refused the spawn")
						end
					end
				elseif not (m and m.Parent) then
					MacroStatus(string.format("Step %d/%d skipped: its unit isn't on the map", i, #steps))
					advance()
				elseif step.type == "upgrade" then
					local cost = UpgradeCost(m)
					if not cost or (step.to and m._stats.upgrade.Value >= step.to) then
						advance()
					elseif Money() < cost then
						status("waiting for " .. cost .. "¥")
					elseif Invoke("upgrade_unit_ingame", InstanceId(m)) then
						-- a recorded multi-level upgrade (to = level) repeats until it gets there
						if not step.to or m._stats.upgrade.Value >= step.to then advance() end
					else
						retry("server refused the upgrade")
					end
				elseif Wave() < (step.wave or 0) then
					status("waiting for wave " .. step.wave)
				elseif step.type == "sell" then
					Invoke("sell_unit_ingame", InstanceId(m))
					advance()
				else
					Invoke("use_active_attack", InstanceId(m), nil, step.slot or 1)
					advance()
				end
			end
		end
	end)

	-- Auto Upgrade, abilities
	task.spawn(function()
		local lastAbility = 0
		while not closed do
			task.wait(1)
			if State.AutoUpgrade and not macroPending and not (State.AutoPlace and State.PlaceBeforeUpgrade and placePending) then
				local best = NextUpgrade()
				if best and Money() >= best.cost then Invoke("upgrade_unit_ingame", InstanceId(best.model)) end
			end

			if State.AutoAbility and os.clock() - lastAbility > 3 then
				lastAbility = os.clock()
				local now = workspace:GetServerTimeNow()
				local USC = Core.UnitServiceCore
				for _, m in MyUnits() do
					local st = m._stats
					local u = Owned(st.uuid.Value)
					if not (u and State.AbilityIgnore[UnitName(u.unit_id)]) then
						for slot = 1, USC.MAX_ACTIVE_SLOTS or 1 do
							local names = USC.active_slot_names(slot)
							local attack, last, cd = st:FindFirstChild(names.attack), st:FindFirstChild(names.last_cast), st:FindFirstChild(names.cooldown)
							if attack and last and cd and attack.Value ~= "nil" and attack.Value ~= "" and now - last.Value >= cd.Value then
								task.spawn(Invoke, "use_active_attack", InstanceId(m), nil, slot)
							end
						end
					end
				end
			end
		end
	end)
end

