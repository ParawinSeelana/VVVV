-- every playable world per mode, easiest first: { name, acts = { { label, id } } }
local MODES = { "Story", "Legend", "Raid" }
local Stages = { Story = {}, Legend = {}, Raid = {} }
for key, w in Data.Worlds do
	local mode = (w.legend_stage and "Legend") or (w.raid_world and "Raid") or (w.infinite and "Story") or nil
	if mode and not w.infinity_castle and not w.sandbox and type(w.levels) == "table" and next(w.levels) then
		local acts = {}
		for act, level in w.levels do table.insert(acts, { n = tonumber(act) or 0, label = "Act " .. act, id = level.id }) end
		table.sort(acts, function(a, b) return a.n < b.n end)
		if w.infinite and w.infinite.id then table.insert(acts, { n = 99, label = "Infinite", id = w.infinite.id }) end
		table.insert(Stages[mode], { name = w.name or key, key = key, rank = w.recommended_level or 0, acts = acts })
	end
end
for _, list in Stages do
	table.sort(list, function(a, b) return a.rank < b.rank or (a.rank == b.rank and a.name < b.name) end)
	local seen = {}
	for _, s in list do
		if seen[s.name] then s.name = s.name .. " (" .. s.key .. ")" end
		seen[s.name] = true
	end
end
