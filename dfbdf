local function RedeemCodes()
	local r = Invoke("get_codes")
	local got = 0
	for _, c in type(r) == "table" and r.codes or {} do
		if not c.redeemed and not c.locked and (r.level or 0) >= (c.min_level or 0) then
			local ok, done = pcall(Client.CodesServiceClient.redeem, c.code)
			if ok and done then got += 1 end
			task.wait(2)
		end
	end
	return got
end
local function ClaimDaily()
	local ok, statuses = pcall(Client.DailyRewardsServiceClient.statuses)
	local got = 0
	for id, st in ok and type(statuses) == "table" and statuses or {} do
		if type(st) == "table" and st.ready and select(2, pcall(Client.DailyRewardsServiceClient.claim, id)) then got += 1 end
	end
	return got
end
