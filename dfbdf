-- a few binders: each control reads its value from tbl[field] and writes it back, then saves
local function Toggle(box, tbl, field, name, tip, onChange)
	return box:CreateToggle({
		Name = name, Tooltip = tip, Style = 2, CurrentValue = tbl[field] == true,
		Callback = function(v)
			if tbl[field] == v then return end
			tbl[field] = v
			Save()
			if onChange then task.spawn(onChange, v) end
		end,
	}, Id("Toggle"))
end
local function Slider(box, tbl, field, name, min, max, tip)
	return box:CreateSlider({
		Name = name, Tooltip = tip, Range = { min, max }, Increment = 1, CurrentValue = tonumber(tbl[field]) or min,
		Callback = function(v)
			v = tonumber(v)
			if not v or tbl[field] == v then return end
			tbl[field] = v
			Save()
		end,
	}, Id("Slider"))
end
-- single pick: tbl[field] = the option; multi: tbl[field] = { [option] = true }
local function Dropdown(box, tbl, field, name, options, tip, onChange, multi)
	local current = {}
	if multi then
		for k in tbl[field] or {} do table.insert(current, k) end
	elseif tbl[field] ~= nil then
		current = { tbl[field] }
	end
	local dd = box:CreateLabel({ Name = name, Tooltip = tip }, Id("Label")):AddDropdown({
		Options = options, CurrentOption = current, MultipleOptions = multi == true, Placeholder = "--",
		Callback = function(list)
			list = type(list) == "table" and list or { list }
			local v
			if multi then
				v = {}
				for _, k in list do v[k] = true end
			else
				v = list[1]
				if v == nil or v == tbl[field] then return end
			end
			tbl[field] = v
			Save()
			if onChange then task.spawn(onChange, v) end
		end,
	}, Id("Dropdown"))
	return dd
end
local function SetOptions(dd, options, current)
	Elevate()
	pcall(dd.Set, dd, { Options = options, CurrentOption = current ~= nil and { current } or {} })
end
local function Button(box, name, tip, fn)
	return box:CreateButton({ Name = name, Tooltip = tip, Callback = function() task.spawn(fn) end }, Id("Button"))
end
local function Input(box, name, placeholder)
	local value = ""
	box:CreateInput({
		Name = name, PlaceholderText = placeholder, CurrentValue = "",
		Callback = function(text) value = tostring(text or "") end,
	}, Id("Input"))
	return function() return value end
end
-- a paragraph that only redraws when its text changes
local function Status(box, title, text)
	local p = box:CreateParagraph({ Name = title, Content = text }, Id("Paragraph"))
	local last = text
	return function(t)
		t = tostring(t)
		if t == last then return end
		last = t
		Elevate()
		pcall(p.Set, p, { Content = t })
	end
end

