-- waits Teleport Delay; false when wanted() turns false meanwhile or the hub closed
function TeleportDelay(why, wanted)
	if State.TeleportDelay > 0 then Notify(string.format("%s in %ds", why, State.TeleportDelay)) end
	local t0 = os.clock()
	while os.clock() - t0 < State.TeleportDelay do
		if closed or not wanted() then return false end
		task.wait(0.2)
	end
	return not closed and wanted()
end

