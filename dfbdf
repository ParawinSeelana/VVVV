local LOGO_URL = "https://github.com/DONUT6599/ddgdhdf/blob/main/Asset_1.png?raw=true"
local function IsImageData(data)
	if type(data) ~= "string" or #data < 100 then return false end
	if data:sub(1, 8) == "\137PNG\r\n\26\n" then return data:sub(-8, -5) == "IEND" end
	return data:sub(1, 3) == "\255\216\255"
end
local function LogoAsset()
	local get = getcustomasset or getsynasset
	if not (get and canFile) then return nil end
	-- only a whole image may reach getcustomasset: a cut-off download crashes the client on every launch
	if not IsImageData(isfile("VaderHug_logo.png") and readfile("VaderHug_logo.png") or nil) then
		local ok, data = pcall(game.HttpGet, game, LOGO_URL)
		if not ok or not IsImageData(data) then return nil end
		writefile("VaderHug_logo.png", data)
	end
	-- getcustomasset can close Roblox outright on some PCs: the flag still saying "running" means the last call
	-- never came back, so the logo is skipped from then on (delete VaderHug_asset_check.txt to try again)
	if isfile("VaderHug_asset_check.txt") and readfile("VaderHug_asset_check.txt") == "running" then return nil end
	writefile("VaderHug_asset_check.txt", "running")
	local ok, id = pcall(get, "VaderHug_logo.png")
	writefile("VaderHug_asset_check.txt", "done")
	return ok and id or nil
end
