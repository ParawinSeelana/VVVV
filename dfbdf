local function SpawnCost(unitId)
	local ok, d = pcall(function() return session.collection:get_upgraded_unit_data(unitId) end)
	local base = (ok and d and d.cost) or (Data.Units[unitId] and Data.Units[unitId].cost) or 0
	local okm, mult = pcall(Core.UnitServiceCore.calculate_spawn_cost_multiplier, session)
	return math.ceil(base * (okm and tonumber(mult) or 1))
end
-- next upgrade's cost, or nil when maxed
local function UpgradeCost(m)
	local st = m._stats
	local def = Data.Units[st.id.Value]
	local nextUp = def and def.upgrade and def.upgrade[st.upgrade.Value + 1]
	if not nextUp or st.upgrade.Value >= (st:FindFirstChild("max_upgrade") and st.max_upgrade.Value or math.huge) then return nil end
	local mult = st:FindFirstChild("upgrade_cost_multiplier") and st.upgrade_cost_multiplier.Value or 1
	return math.ceil(nextUp.cost * mult)
end

-- how strong a unit gets (the Farmer's rank): DPS at its last upgrade tier, with this copy's traits and stat rolls
-- counted by the game's own multipliers. unit = the owned unit's record
local function UnitDps(data, unit)
	local damage, cooldown = data.damage, data.attack_cooldown
	for _, tier in type(data.upgrade) == "table" and data.upgrade or {} do
		damage, cooldown = tier.damage or damage, tier.attack_cooldown or cooldown
	end
	local dps = damage and cooldown and cooldown ~= 0 and damage / cooldown or 0
	local T = unit and Core.TraitServiceCore
	if not T then return dps end
	local ok, dmg, cd = pcall(function()
		return T.calculate_trait_multiplier(unit, "increase_damage") * T.calculate_total_stat_multiplier(unit, "increase_damage"),
			T.calculate_trait_multiplier(unit, "decrease_cooldown") * T.calculate_total_stat_multiplier(unit, "decrease_cooldown")
	end)
	if not ok or type(dmg) ~= "number" or type(cd) ~= "number" or cd <= 0 then return dps end
	return dps * dmg / cd
end

local State -- set below; NextUpgrade reads it
-- the next upgrade among your units on the map (nil when none has one left). Ticked Upgrade Priority units go first,
-- top row first, and saving up for one holds the rest back (AA). The rest by Upgrade Order; Smart is the Farmer's:
-- farms first, the cheapest, nothing else while saving for one; then the damage units, the strongest one money pays
-- for right now (else saving for the cheapest of them); buff units last, once nothing else has an upgrade left
local function NextUpgrade()
	local rank = {}
	for i, e in State.UpgradePriority do
		if e.on then rank[e.id] = i end
	end
	local list = {}
	for _, m in MyUnits() do
		local st = m._stats
		local cost = UpgradeCost(m)
		if cost and st.upgrade.Value < State.UpgradeUntil then
			local u = Owned(st.uuid.Value)
			local d = Data.Units[st.id.Value] or {}
			table.insert(list, {
				model = m, cost = cost, prio = u and rank[UnitName(u.unit_id)] or math.huge, damage = st.damage.Value,
				farm = IsFarm(st.id.Value), buff = d._show_as_buff_unit == true,
				rank = math.floor(UnitDps(d, u)) * 1000 + st.upgrade.Value,
			})
		end
	end
	local top
	for _, c in list do
		if c.prio < math.huge and (not top or c.prio < top.prio or (c.prio == top.prio and c.cost < top.cost)) then top = c end
	end
	if top then return top end
	if State.UpgradeOrder == "Smart" then
		local farms, hitters, buffs = {}, {}, {}
		for _, c in list do table.insert(c.buff and buffs or c.farm and farms or hitters, c) end
		local function pick(group, strongest)
			local best, cheapest
			for _, c in group do
				if not cheapest or c.cost < cheapest.cost then cheapest = c end
				if strongest and c.cost <= Money() and (not best or c.rank > best.rank) then best = c end
			end
			return best or cheapest
		end
		return pick(farms) or pick(hitters, true) or pick(buffs)
	end
	local best
	for _, c in list do
		c.score = State.UpgradeOrder == "Strongest first" and c.damage
			or -c.cost + (State.UpgradeOrder == "Farms first" and c.farm and 1e9 or 0)
		if not best or c.score > best.score then best = c end
	end
	return best
end

local function CurrentMode()
