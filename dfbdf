-- AA's holograms: a see-through copy of each unit on the spot Auto Place will use next, in the order it will place
-- them ("slot·copy"), and per slot a disc over its area with a pin on every free spot in it. On this client only;
-- clones the game's stored unit template, so no unit setup script runs
local HOLOGRAM_COLOR = Color3.fromRGB(132, 88, 240)
local HOLOGRAM_STRIP = { "Decal", "Texture", "SurfaceAppearance", "Script", "LocalScript", "ModuleScript", "Humanoid",
	"Sound", "ParticleEmitter", "Trail", "Beam", "BillboardGui", "Light" }
local hologramFolder

local function GhostPart(props)
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
	p.Material, p.Color = Enum.Material.Neon, HOLOGRAM_COLOR
	for k, v in props do p[k] = v end
	return p
end

local function ClearHolograms()
	if hologramFolder then hologramFolder:Destroy() end
	hologramFolder = nil
end

local function Hologram(s, spot, copy, parent)
	local template = (Core.UnitServiceCore.unit_chars or {})[s.u.unit_id]
	local root = template and (template.PrimaryPart or template:FindFirstChild("HumanoidRootPart"))
	local half = root and root.Size.Y / 2 or 1
	local holo = template and template:Clone()
	if holo then
		for _, d in holo:GetDescendants() do
			local strip = false
			for _, class in HOLOGRAM_STRIP do
				if d:IsA(class) then strip = true break end
			end
			if strip then
				d:Destroy()
			elseif d:IsA("BasePart") then
				d.Anchored, d.CanCollide, d.CanQuery, d.CanTouch, d.CastShadow = true, false, false, false, false
				d.Material, d.Color = Enum.Material.ForceField, HOLOGRAM_COLOR
				if d:IsA("MeshPart") then pcall(function() d.TextureID = "" end) end
			elseif d:IsA("SpecialMesh") then
				d.TextureId = ""
			end
		end
		holo:PivotTo(CFrame.lookAt(spot + Vector3.new(0, half, 0), Vector3.new(s.anchor.X, spot.Y + half, s.anchor.Z)))
	else
		holo = GhostPart({
			Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.2, 4, 4), Material = Enum.Material.ForceField,
			CFrame = CFrame.new(spot + Vector3.new(0, 0.1, 0)) * CFrame.Angles(0, 0, math.pi / 2),
		})
	end
	local tag = Instance.new("BillboardGui")
	tag.Size, tag.StudsOffsetWorldSpace, tag.AlwaysOnTop = UDim2.fromOffset(34, 18), Vector3.new(0, 3, 0), true
	tag.Adornee = holo:IsA("Model") and (holo.PrimaryPart or holo:FindFirstChildWhichIsA("BasePart")) or holo
	tag.Parent = holo
	local label = Instance.new("TextLabel")
	label.Size, label.BackgroundTransparency, label.Text, label.TextScaled = UDim2.fromScale(1, 1), 1, s.slot .. "·" .. copy, true
	label.Font, label.TextColor3, label.TextStrokeTransparency, label.Parent = Enum.Font.GothamBold, Color3.new(1, 1, 1), 0, tag
	holo.Parent = parent
end

-- lays out holograms for every placement still to come (up to 36), picking slots the way Auto Place does
local function BuildHolograms(slots, bad, full)
	ClearHolograms()
	local folder = Instance.new("Folder")
	folder.Name, folder.Parent = "VaderHolograms", workspace
	hologramFolder = folder
	local counts, skip, reserved, spread = {}, {}, {}, {} -- spread: slot -> farthest planned spot from its point
	for _, s in slots do counts[s.slot] = s.count end
	for _ = 1, 36 do
		if closed or hologramFolder ~= folder then return end
		local pick
		for _, s in slots do
			if not full[s.uuid] and not skip[s.slot] and counts[s.slot] < s.cap then
				local before = not pick or (State.FarmsFirst and s.farm and not pick.farm)
					or ((not State.FarmsFirst or s.farm == pick.farm) and counts[s.slot] < counts[pick.slot])
				if before then pick = s end
			end
		end
		if not pick then break end
		local spot = FindSpot(pick.data, pick.anchor, bad, reserved)
		if spot then
			table.insert(reserved, spot)
			counts[pick.slot] += 1
			Hologram(pick, spot, counts[pick.slot], folder)
			spread[pick.slot] = math.max(spread[pick.slot] or 0, Vector2.new(spot.X - pick.anchor.X, spot.Z - pick.anchor.Z).Magnitude)
		else
			skip[pick.slot] = true
		end
		task.wait() -- one spot search a frame, so a rebuild doesn't hitch the game
	end
	local units, blockers = MyUnits(), Blockers(reserved)
	for _, s in slots do
		if closed or hologramFolder ~= folder then return end
		local radius = spread[s.slot] or 0
		for _, m in units do
			if m._stats.uuid.Value == s.uuid then
				local p = m:GetPivot().Position
				radius = math.max(radius, Vector2.new(p.X - s.anchor.X, p.Z - s.anchor.Z).Magnitude)
			end
		end
		-- ponytail: 6-15 studs with pins 3 apart keeps it to ~80 ground checks a slot (AA's limit, wider lagged)
		radius = math.clamp(radius + 3, 6, 15)
		local ground = Core.PlacementCore.raycast(s.anchor + Vector3.new(0, 40, 0), Vector3.new(0, -120, 0))
		GhostPart({
			Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.2, radius * 2, radius * 2), Transparency = 0.8, Parent = folder,
			CFrame = CFrame.new(Vector3.new(s.anchor.X, (ground and ground.Position.Y or s.anchor.Y) + 0.1, s.anchor.Z)) * CFrame.Angles(0, 0, math.pi / 2),
		})
		for dx = -radius, radius, 3 do
			for dz = -radius, radius, 3 do
				local spot = dx * dx + dz * dz <= radius * radius and SpotAt(s.data, s.anchor.X + dx, s.anchor.Y, s.anchor.Z + dz, blockers)
				if spot then
					GhostPart({
						Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.2, 0.4, 0.4), Color = Color3.new(1, 1, 1), Transparency = 0.3,
						CFrame = CFrame.new(spot + Vector3.new(0, 0.6, 0)) * CFrame.Angles(0, 0, math.pi / 2), Parent = folder,
					})
				end
			end
		end
		task.wait()
	end
end

