	local cache = pve and Core.PathService.PATH_CACHE and Core.PathService.PATH_CACHE[pve]
	local list = {}
	for _, lane in folder and folder:GetChildren() or {} do
		local c = cache and cache[lane]
		if c and c.points and #c.points >= 2 then table.insert(list, { name = lane.Name, points = c.points }) end
	end
	table.sort(list, function(a, b) return (tonumber(a.name) or 99) < (tonumber(b.name) or 99) end)
	return list
end
-- a point percent of the way along a lane, spawn to base
local function PathPoint(points, percent)
	local target = points[#points].distance_from_spawn * math.clamp(percent, 0, 100) / 100
	for i = 2, #points do
		local a, b = points[i - 1], points[i]
		if b.distance_from_spawn >= target then
			local span = math.max(b.distance_from_spawn - a.distance_from_spawn, 1e-6)
			return a.position:Lerp(b.position, math.clamp((target - a.distance_from_spawn) / span, 0, 1))
		end
	end
	return points[#points].position
end

-- a slot's anchor: its saved spot on this map, else Placement Distance % along the first lane
local function PlaceAnchor(slot, unitId)
	local cfg = State.Slots[tostring(slot)]
	if cfg.Mode == "My position" then
		local p = placePositions[tostring(MapKey()) .. "|" .. tostring(slot)]
		if p then return Vector3.new(p[1], p[2], p[3]), "saved spot" end
	end
	local lane = Lanes()[1]
	if not lane then return nil, "enemy path not loaded yet" end
	local percent = IsFarm(unitId) and State.FarmPlaceDistance or State.PlaceDistance
	return PathPoint(lane.points, percent), percent .. "% of the path"
end

-- ground the game takes for this unit at x, z: the game's own placement raycasts, off the road, 2.5 studs from any unit.
-- Returns the ground point and the ray origin spawn_unit wants
-- ponytail: tries origins 40 / 12 / 4 studs up instead of the game's see-through + path-ceiling walk; roofed maps may
-- need that if spots keep getting refused
local UNIT_GAP = 2.5
local function SpotAt(data, x, refY, z, blockers)
	local PC = Core.PlacementCore
	if not PC._initialized then return nil end
	local road = workspace:FindFirstChild("_road")
	for _, up in { 40, 12, 4 } do
		local origin = Vector3.new(x, refY + up, z)
		local hit = PC.raycast(origin, Vector3.new(0, -120, 0))
		if hit and PC.is_valid_raycast_hit(hit.Instance, data) and not hit.Instance:HasTag("blacklistobject") then
			local check = PC.raycastCheck(origin, Vector3.new(0, -150, 0))
			local inst = check and check.Instance
			if inst and (inst:HasTag("blacklistobject") or (road and inst:IsDescendantOf(road)) or inst:IsDescendantOf(workspace._UNITS)) then
				return nil
			end
			for _, p in blockers do
				if Vector2.new(p.X - hit.Position.X, p.Z - hit.Position.Z).Magnitude < UNIT_GAP then return nil end
			end
			return hit.Position, origin
		end
	end
end

-- every placed unit, yours or a teammate's, plus reserved spots (holograms not placed yet)
local function Blockers(reserved)
	local blockers = table.clone(reserved or {})
	for _, m in CS:GetTagged("player_units") do
		if m:IsDescendantOf(workspace) then table.insert(blockers, m:GetPivot().Position) end
	end
	return blockers
end

-- the free spot nearest the anchor, in 1.5-stud rings out to 30 studs; bad = spots the server refused
local function FindSpot(data, anchor, bad, reserved)
	local blockers = Blockers(reserved)
	for r = 0, 30, 1.5 do
		local steps = r == 0 and 1 or math.max(8, math.floor(2 * math.pi * r / 1.5))
		for k = 0, steps - 1 do
			local a = 2 * math.pi * k / steps
			local x, z = anchor.X + math.cos(a) * r, anchor.Z + math.sin(a) * r
			local key = math.floor(x) .. "," .. math.floor(z)
			if not bad[key] then
				local spot, origin = SpotAt(data, x, anchor.Y, z, blockers)
				if spot then return spot, origin, key end
			end
		end
	end
end

local function Spawn(uuid, origin, rotation)
	return Invoke("spawn_unit", uuid, { Origin = origin, Direction = Vector3.new(0, -1, 0) }, rotation or 0)
end

-- the model a spawn just made: your new copy of that collection unit
local function NewUnit(uuid, before, timeout)
	local t0 = os.clock()
	repeat
		for _, m in MyUnits() do
			if m._stats.uuid.Value == uuid and not before[InstanceId(m)] then return m end
		end
		task.wait(0.2)
	until os.clock() - t0 > (timeout or 3)
end
local function Snapshot()
	local before = {}
	for _, m in MyUnits() do before[InstanceId(m)] = true end
	return before
end

