	if name == "" then Notify("Type a name first (letters, numbers, space, _ and -).") return nil end
	if canFile and isfile(MacroPath(name)) then Notify(name .. " already exists.") return nil end
	return name
end
Button(ManageBox, "Create Macro", nil, function()
	local name = TypedName()
	if not name then return end
	SaveMacro(name, {})
	State.MacroName = name
	Save()
	RefreshMacros()
	Notify("Created " .. name)
end)
Button(ManageBox, "Rename Selected Macro", "Assignments follow it.", function()
	local old = State.MacroName
	if not old then return Notify("Pick a macro to rename.") end
	local name = TypedName()
	if not name then return end
	writefile(MacroPath(name), readfile(MacroPath(old)))
	if type(delfile) == "function" then delfile(MacroPath(old)) end
	for key, assigned in assignments do
		if assigned == old then assignments[key] = name end
	end
	WriteJson(ASSIGN, assignments)
	State.MacroName = name
	Save()
	RefreshMacros()
	Notify("Renamed " .. old .. " to " .. name)
end)
local deleteArmed
Button(ManageBox, "Delete Selected Macro", "Press twice within 5s.", function()
	local name = State.MacroName
	if not name then return Notify("Pick a macro to delete.") end
	if deleteArmed ~= name then
		deleteArmed = name
		task.delay(5, function() if deleteArmed == name then deleteArmed = nil end end)
		return Notify("Press again to delete " .. name .. " and its assignments.")
	end
	deleteArmed = nil
	if type(delfile) == "function" then delfile(MacroPath(name)) end
	for key, assigned in assignments do
		if assigned == name then assignments[key] = nil end
	end
	WriteJson(ASSIGN, assignments)
	RefreshMacros()
	Notify("Deleted " .. name)
end)

local ShareBox = Box(Tabs.Macro, "Share", 1)
local typedLink = Input(ShareBox, "Link Or JSON", "https://...json or pasted macro JSON")
Button(ShareBox, "Install Macro", "Saved under Name, or its own name.", function()
	local text = (typedLink():gsub("^%s+", ""):gsub("%s+$", ""))
	local isLink = text:match("^https?://") ~= nil
	if not isLink and text:sub(1, 1) ~= "{" then return Notify("Paste a link that starts with https:// or a macro's JSON.") end
	local body = text
	if isLink then
		local ok, result = pcall(game.HttpGet, game, text)
		if not ok then return Notify("Download failed: " .. tostring(result)) end
		body = result
	end
	local ok, data = pcall(Http.JSONDecode, Http, body)
	if not ok or type(data) ~= "table" or type(data.steps) ~= "table" then return Notify("That isn't a macro.") end
	local name = CleanName(typedName())
	if name == "" then name = CleanName(data.name or (isLink and text:match("([^/?#]+)%.json"))) end
	if name == "" then name = "Macro" end
	SaveMacro(name, data.steps)
	State.MacroName = name
	Save()
	RefreshMacros()
	Notify("Installed " .. name .. " - " .. Summary(data.steps))
end)
Button(ShareBox, "Export Selected Macro", "Copies its JSON.", function()
	local name = State.MacroName
	if not name then return Notify("Pick a macro to export.") end
	local copy = setclipboard or toclipboard
	local steps = LoadMacro(name)
	if type(copy) ~= "function" or not pcall(copy, Http:JSONEncode({ name = name, steps = steps })) then
		return Notify("Couldn't copy to the clipboard.")
	end
	Notify("Copied " .. name .. " - " .. Summary(steps))
end)

