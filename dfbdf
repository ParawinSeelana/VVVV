-- steps: spawn { unit_id, origin, dir, rot, wave } | upgrade { unit, to } | sell { unit, wave } | ability { unit, slot, wave };
-- unit = the index of the spawn step that placed it
local MACRO_ACTIONS = { spawn_unit = "spawn", upgrade_unit_ingame = "upgrade", sell_unit_ingame = "sell", use_active_attack = "ability" }
local MACRO_MODES = { "Story", "Legend", "Raid", "Infinite", "Challenge", "Other" }
local recording, recordTarget = nil, nil
local recordStep = {} -- placed copy id -> its spawn step, while recording
local MacroStatus

local function V(t) return Vector3.new(t[1], t[2], t[3]) end
local function T(v) return { v.X, v.Y, v.Z } end
local function CleanName(name) return (tostring(name or ""):gsub("[^%w_%- ]", ""):gsub("^%s+", ""):gsub("%s+$", "")) end
local function MacroPath(name) return MACROS .. "/" .. name .. ".json" end
local function ListMacros()
	local names = {}
	if canFile and type(listfiles) == "function" then
		for _, path in listfiles(MACROS) do
			local name = path:match("([^/\\]+)%.json$")
			if name then table.insert(names, name) end
		end
	end
	table.sort(names)
	return names
end
local function LoadMacro(name) return name and ReadJson(MacroPath(name), {}).steps or {} end
local function SaveMacro(name, steps) WriteJson(MacroPath(name), { steps = steps }) end
local function Summary(steps)
	local c = { spawn = 0, upgrade = 0, sell = 0, ability = 0 }
	for _, s in steps do c[s.type] = (c[s.type] or 0) + 1 end
	return string.format("%d steps: %d spawn, %d upgrade, %d sell, %d ability", #steps, c.spawn, c.upgrade, c.sell, c.ability)
end
local function ActiveMacroName()
	if State.AutoSwitchMacro then
		local mode = CurrentMode()
		local name = mode and (assignments[mode .. "|" .. tostring(MapKey())] or assignments[mode .. "|Any map"])
		if name then return name end
	end
	return State.MacroName
end

-- stands in for the game's EndpointsClient.invoke_server: your clicks and the hub's own actions both land in a recording
local function RecordingInvoke(name, ...)
	local action = State.RecordMacro and MACRO_ACTIONS[name]
	if not action then return origInvoke(name, ...) end
	if not recording then
		recording, recordTarget = {}, nil
		table.clear(recordStep)
	end
	local args = table.pack(...)
	local before = action == "spawn" and Snapshot()
	local unitStep = action ~= "spawn" and recordStep[args[1]] -- resolve first: a sold unit is gone afterwards
	local result = table.pack(origInvoke(name, ...))
	local step
	if action == "spawn" and result[1] then
		local u, ray = Owned(args[1]), args[2]
		if u and type(ray) == "table" and typeof(ray.Origin) == "Vector3" then
			step = { type = "spawn", wave = Wave(), unit_id = u.unit_id, origin = T(ray.Origin), dir = T(ray.Direction), rot = tonumber(args[3]) or 0 }
			table.insert(recording, step)
			local index, rec = #recording, recording
			task.spawn(function()
				local m = NewUnit(args[1], before, 3)
				if m and rec == recording then recordStep[InstanceId(m)] = index end
			end)
		end
	elseif unitStep and (result[1] or action ~= "upgrade") then
		step = { type = action, wave = Wave(), unit = unitStep }
		if action == "upgrade" then step.to = tonumber(args[3]) end
		if action == "ability" then step.slot = tonumber(args[3]) end
		table.insert(recording, step)
	end
	if step then
		local isNew = not recordTarget
		recordTarget = recordTarget or ActiveMacroName() or CleanName((CurrentMode() or "Macro") .. "_" .. tostring(MapKey()))
		SaveMacro(recordTarget, recording)
		if MacroStatus then MacroStatus("Recording into " .. recordTarget .. " - " .. Summary(recording)) end
		if isNew and Env.ACXRefreshMacros then task.spawn(Env.ACXRefreshMacros) end
	end
	return table.unpack(result, 1, result.n)
end
EP.invoke_server = RecordingInvoke

