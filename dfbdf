-- your units on the map (enemies share _UNITS; their _stats have no player)
local function MyUnits()
	local list = {}
	for _, m in workspace:FindFirstChild("_UNITS") and workspace._UNITS:GetChildren() or {} do
		local st = m:FindFirstChild("_stats")
		local owner = st and st:FindFirstChild("player")
		if owner and owner.Value == LP and st:FindFirstChild("upgrade") and not CS:HasTag(m, "minion_units") then
			table.insert(list, m)
		end
	end
	return list
end
